# Application
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Enable only when the trusted edge replaces/sanitizes X-Forwarded-For and X-Real-IP.
TRUST_PROXY=false
=
# Security housekeeping retention after expiry/revocation (0-3650 days).
SECURITY_RATE_LIMIT_RETENTION_DAYS=1
SECURITY_SESSION_RETENTION_DAYS=30
=
# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tournamentspro
=
RIOT_API_KEY=
