# Application
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
TRUST_PROXY=false

SECURITY_RATE_LIMIT_RETENTION_DAYS=7
SECURITY_SESSION_RETENTION_DAYS=30

# MySQL (Local XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tournamentspro

# Database Provider Selection (supabase / mysql)
DATABASE_PROVIDER=mysql

# Supabase Configuration & Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tournamentspro-media

# eSports & Games External APIs
RIOT_API_KEY=
FORTNITE_API_KEY=
BALLCHASING_API_KEY=
STEAM_API_KEY=
FACEIT_API_KEY=
